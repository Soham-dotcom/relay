# Local: `npm run db:local` starts Postgres on 5433. Production: your Neon connection string.
DATABASE_URL=postgresql://relay:relay@localhost:5433/relay

# Free key from https://aistudio.google.com/apikey . Leave empty to run without AI (features degrade).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
AI_TIMEOUT_MS=25000

PORT=4000
LOG_LEVEL=info
LOG_FILE=logs/app.log
